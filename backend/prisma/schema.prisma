// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------- 1. CINEMA --------------------
model Cinema {
  id        Int      @id @default(autoincrement())
  name      String
  address   String?
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rooms     Room[]

  @@map("cinema")
}

// -------------------- 2. ROOM --------------------
model Room {
  id        Int      @id @default(autoincrement())
  cinemaId  Int      @map("cinema_id")
  name      String
  numRows   Int      @map("num_rows")
  numCols   Int      @map("num_cols")
  capacity  Int
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cinema    Cinema   @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  seats     Seat[]
  showtimes Showtime[]

  @@map("room")
}

// -------------------- 3. SEAT --------------------
model Seat {
  id           Int      @id @default(autoincrement())
  roomId       Int      @map("room_id")
  rowNumber    Int      @map("row_number")
  columnNumber Int      @map("column_number")
  seatCode     String   @map("seat_code")
  seatType     String   @default("STANDARD") @map("seat_type") // STANDARD, VIP, COUPLE, ...
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  room         Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bookingSeats BookingSeat[]
  showtimeSeats ShowtimeSeat[]

  @@unique([roomId, seatCode])
  @@map("seat")
}

// -------------------- 4. MOVIE --------------------
model Movie {
  id              Int      @id @default(autoincrement())
  title           String
  description     String?
  durationMinutes Int      @map("duration_minutes")
  releaseDate     DateTime? @map("release_date")
  ageRating       String?  @map("age_rating")
  posterUrl       String?  @map("poster_url")
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  showtimes       Showtime[]

  @@map("movie")
}

// -------------------- 5. USER --------------------
model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  phone        String?
  role         String    @default("CUSTOMER")
  status       String    @default("ACTIVE")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  bookings     Booking[]

  @@map("user")
}

// -------------------- 6. SHOWTIME --------------------
model Showtime {
  id        Int      @id @default(autoincrement())
  movieId   Int      @map("movie_id")
  roomId    Int      @map("room_id")
  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")
  status    String   @default("SCHEDULED")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bookings  Booking[]
  showtimeSeats ShowtimeSeat[]

  @@map("showtime")
}

// -------------------- 7. BOOKING --------------------
model Booking {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  showtimeId  Int      @map("showtime_id")
  bookingCode String   @unique @map("booking_code")
  status      String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED, EXPIRED
  totalAmount Int      @map("total_amount")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  showtime    Showtime @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  bookingSeats BookingSeat[]
  payments    Payment[]

  @@map("booking")
}

// -------------------- 8. PAYMENT --------------------
model Payment {
  id            Int       @id @default(autoincrement())
  bookingId     Int       @map("booking_id")
  amount        Int
  method        String
  status        String    @default("PENDING")
  transactionId String?   @unique @map("transaction_id")
  paidAt        DateTime? @map("paid_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  booking       Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payment")
}

// -------------------- 9. BOOKING SEAT (Bảng trung gian N-N) --------------------
model BookingSeat {
  id        Int      @id @default(autoincrement())
  bookingId Int      @map("booking_id")
  seatId    Int      @map("seat_id")
  price     Int
  createdAt DateTime @default(now()) @map("created_at")

  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seat      Seat     @relation(fields: [seatId], references: [id], onDelete: Cascade)

  @@unique([bookingId, seatId])
  @@map("booking_seat")
}

// -------------------- 10. SHOWTIME SEAT (Trạng thái ghế theo suất chiếu) --------------------
model ShowtimeSeat {
  id            Int      @id @default(autoincrement())
  showtimeId    Int      @map("showtime_id")
  seatId        Int      @map("seat_id")
  status        String   @default("AVAILABLE") // AVAILABLE, HELD, BOOKED
  bookingId     Int?     @map("booking_id")
  holdExpiresAt DateTime? @map("hold_expires_at")
  price         Int?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  showtime      Showtime @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  seat          Seat     @relation(fields: [seatId], references: [id], onDelete: Cascade)

  @@unique([showtimeId, seatId])
  @@map("showtime_seat")
}